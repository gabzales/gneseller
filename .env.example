# Shared Supabase project (PRD 1: "1 Database untuk 2 Domain")
# Same values go on ghostnewera.web.id's Vercel project too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client. Used by API routes that
# mutate balance/keys (see PRD 5, Row Level Security).
SUPABASE_SERVICE_ROLE_KEY=

# GensPay QRIS gateway credentials, used both to create transactions and
# to verify webhook callback signatures. See src/app/api/topup/create/route.ts
# + webhooks/topup/route.ts. Same GENSPAY_API_KEY value is used for both the
# X-API-Key auth header on create AND as the HMAC-ish secret for webhook
# signature verification (SHA256(rawBody + apiKey), NOT HMAC).
GENSPAY_BASE_URL=
GENSPAY_API_KEY=

# Used to build the callback_url sent on every GensPay /transaction/create
# request (src/app/api/topup/create/route.ts) -- without this, GensPay may
# have nowhere to send the transaction.updated webhook, which looks
# exactly like "customer paid but balance never credited". Defaults to
# https://ghostseller.my.id if unset -- override for staging/local.
APP_URL=https://ghostseller.my.id

# Optional -- protects GET /api/debug/genspay, a browser-openable
# diagnostic page (no admin login needed) that shows the resolved
# GensPay config (masked) + runs the same test-transaction check as the
# admin panel's "Test & Debug" button. Isi string rahasia apa saja,
# redeploy, lalu buka:
#   https://domainkamu.com/api/debug/genspay?secret=ISI_DI_SINI
# Kosongkan/hapus var ini lagi setelah selesai debug -- endpoint ini
# selalu 503 kalau var-nya tidak diisi, jadi aman by default, tapi kalau
# diisi dan lupa dihapus, siapa pun yang tahu secretnya bisa buka.
GENSPAY_DEBUG_SECRET=

# WhatsApp number the "Daftar Reseller" button on the landing page opens a
# chat to (format: country code + number, no +/spaces, e.g. 628123456789).
# NEXT_PUBLIC_ because the landing page renders this button client-side.
# Change this any time in your hosting provider's env settings -- no code
# change or redeploy of the component itself needed.
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=

# Secret buat endpoint /api/setup-admin -- cara bikin akun admin lewat
# browser tanpa perlu setup lokal (node_modules/.env.local). Isi bebas,
# string rahasia apa saja (bukan password akun, cuma "kunci" biar orang
# lain gak bisa asal buka endpoint ini). HAPUS var ini (atau hapus file
# src/app/api/setup-admin/route.ts sekalian) setelah selesai dipakai --
# endpoint ini sengaja untuk kemudahan setup SEKALI di awal, bukan untuk
# dibiarkan aktif selamanya.
SETUP_ADMIN_SECRET=
